# Memory pipeline configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# ── API credentials ────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1

# ── LLM model name ─────────────────────────────────────────────────────────────
# Used for memory text calls: session summary, event link, event table, chapter segmentation.
# MEMORY_TEXT_MODEL=deepseek-v4-flash

# ── Local model paths ──────────────────────────────────────────────────────────
# QWEN_CHECKPOINT=/root/models/Qwen3-VL-8B-Instruct
# WHISPER_MODEL_DIR=/root/models/whisper-large-v3-turbo

# ── Output directory ───────────────────────────────────────────────────────────
# Default: <MMM_root>/results  (leave commented out to use the default)
# OUTPUT_ROOT=/custom/path/to/results
