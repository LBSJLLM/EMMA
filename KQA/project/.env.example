# Shell environment for KQA.  Copy to .env, fill in your provider values, then
# load it with: set -a; source .env; set +a
# Do not commit .env.

# Reasoning API used by DeepSeek-V4-Flash and DeepSeek R1.
OPENAI_API_KEY=your-reasoning-api-key
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1

# Optional separate embedding provider.  If omitted, OPENAI_* is reused.
# EMBED_API_KEY=your-embedding-api-key
# EMBED_BASE_URL=https://your-embedding-endpoint/v1
